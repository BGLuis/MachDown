{
  "manifest_version": 3,
  "name": "MachDown Accelerator",
  "version": "1.0",
  "description": "Envia downloads pesados para o seu servidor MachDown",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "downloads",
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configurações do MachDown"
  }
}
